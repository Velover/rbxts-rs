// roblox-ts's transform order (`getChangedFilePaths` of a clean build), which rbxts-rs builds in
// (`build::transform_order`): imports, a triple-slash reference, a module augmentation and an import of an ambient
// module make it differ from program order. `expected/`: stock roblox-ts's `rbxtsc build` output; `order.txt`: the
// order stock transforms the files in (`getChangedSourceFiles` on a fresh builder), which `tests/fixtures.rs` checks.
{
	"include": ["src"],
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts"],
		"types": ["types", "compiler-types"],
		"experimentalDecorators": true,
		"rootDir": "src",
		"outDir": "out",
		"paths": { "*": ["./src/*"] }
	}
}
