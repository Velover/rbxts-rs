// The loops area's fixture: for (numeric and fallback), for-of (every loop builder, $range), while, do-while, and
// roblox-ts's loop.spec.ts (its destructuring tests came with the binding area).
// `expected/`: roblox-ts master (`probe/rbxts-driver.cjs`); the TypeScript 5 and tsrs backends give the same output.
{
	"include": ["src", "node_modules/@rbxts/testez/globals.d.ts"],
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts"],
		"types": ["types", "compiler-types"],
		"experimentalDecorators": true,
		"rootDir": "src",
		"outDir": "out",
		"paths": { "*": ["./src/*"] }
	}
}
