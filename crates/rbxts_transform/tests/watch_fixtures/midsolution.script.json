{
	"steps": [
		{
			"name": "an edit in the root alone: every referenced project is skipped",
			"do": [{ "patch": { "file": "src/main.server.ts", "find": "make(3).kind", "replace": "make(4).kind" } }]
		},
		{
			"name": "an edit in right: left and common are skipped, the root rebuilt through the solution config",
			"do": [{ "patch": { "file": "projects/right/src/index.ts", "find": "bump();", "replace": "bump();\n\tbump();" } }]
		},
		{
			"name": "an error in common and a root edit in one build: the solution config passes the failure on",
			"do": [
				{ "patch": { "file": "projects/common/src/util/math.ts", "find": "export const twice", "replace": "export const bad: number = \"x\";\nexport const twice" } },
				{ "patch": { "file": "src/main.server.ts", "find": "make(4).kind", "replace": "make(5).kind" } }
			],
			"expect": "error"
		},
		{
			"name": "common fixed",
			"do": [{ "patch": { "file": "projects/common/src/util/math.ts", "find": "export const bad: number = \"x\";\n", "replace": "" } }]
		},
		{
			"name": "an error in left: right builds, the group and the root are blocked",
			"do": [{ "patch": { "file": "projects/left/src/index.ts", "find": "make(twice(1))", "replace": "make(\"1\")" } }],
			"expect": "error"
		},
		{
			"name": "a root edit while left still fails",
			"do": [{ "patch": { "file": "src/main.server.ts", "find": "make(5).kind", "replace": "make(6).kind" } }],
			"expect": "error"
		},
		{
			"name": "an edit in right while left still fails",
			"do": [{ "patch": { "file": "projects/right/src/index.ts", "find": "bump();\n\tbump();", "replace": "bump();" } }],
			"expect": "error"
		},
		{
			"name": "left fixed",
			"do": [{ "patch": { "file": "projects/left/src/index.ts", "find": "make(\"1\")", "replace": "make(twice(1))" } }]
		},
		{
			"name": "an unchanged save of the solution config: every project is dirty",
			"do": [{ "touch": "projects/group/tsconfig.json" }]
		},
		{
			"name": "an unchanged save in common",
			"do": [{ "touch": "projects/common/src/index.ts" }]
		}
	]
}
