{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": [
			"node_modules/@rbxts"
		],
		"rootDir": "src",
		"outDir": "out"
	},
	"include": [
		"src"
	],
	"rbxts": {
		"type": "bogus"
	}
}
