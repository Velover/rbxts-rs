{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noLib": false,
		"moduleDetection": "force",
		"target": "ESNext",
		"typeRoots": [
			"types"
		],
		"rootDir": "src",
		"types": [
			"missing"
		]
	},
	"include": [
		"src"
	]
}
